---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, location } from '../data/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { title, description, path, noindex, structuredData = [] } = Astro.props;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brandName,
  description: site.description,
  url: site.url,
  areaServed: [location.city, 'Online'],
  founder: {
    '@type': 'Person',
    name: site.personName,
  },
};

const schemas = [baseSchema, ...structuredData];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
      ))
    }
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
